# Activiity Chatbot v0.2 - Environment Configuration
# Copy this file to .env and fill in your values

# Required for cloud LLM access via OpenRouter
OPENROUTER_API_KEY=sk-or-v1-YOUR-KEY-HERE

# LLM Provider: "openrouter" (default) or "ollama"
LLM_PROVIDER=openrouter

# Router model (used in agentic mode)
LLM_MODEL=qwen/qwen3-14b

# Synthesis model (used in agentic mode for final answer generation)
SYNTH_MODEL=qwen/qwen3-8b

# Embedding provider: "ollama" (default) or "openai"
EMBED_PROVIDER=ollama

# Embedding model (for Ollama)
OLLAMA_EMBED_MODEL=bge-m3

# Qdrant vector store URL
QDRANT_URL=http://localhost:6333

# RAG mode: "agentic" or "naive"
CHAT_RAG_MODE=agentic

# Enable reranker for better retrieval
USE_RERANKER=false

# Max ReAct iterations for agentic mode
AGENT_MAX_ITER=2

# Max conversation history turns to keep
CHAT_MAX_HISTORY=10

# Use short-optimized prompts (less tokens)
SLM_MODE=true